# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_haui
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Cấu hình LLM Provider: "ollama" (Local GPU - Qwen 3.5 4B) hoặc "gemini" (Cloud)
LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
# Tối ưu VRAM 3.0 - 3.5 GB trên GPU RTX 3050 (4GB)
OLLAMA_NUM_CTX=3072
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_GPU=999
LLM_MODEL=gemini-3.6-flash
FALLBACK_LLM_MODEL=gemini-3.1-flash-lite

# Server (Tùy chọn)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
